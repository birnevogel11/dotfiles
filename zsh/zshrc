# vim: ft=zsh foldmethod=marker foldcolumn=1 foldlevelstart=0
# zM: foldall
# Global path and language setting {{{
export LC_ALL="en_US.UTF-8"
export LANG="en_US.UTF-8"
export ZSHRC_DIR="${HOME}/.config/${USER}/zsh"
export PATH="${PATH}:${HOME}/usr/bin:${HOME}/.local/bin:${HOME}/.local/bin:${HOME}/usr/rc/script"
# }}}
# Zinit {{{
[[ -d "${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git" ]] && source ${ZSHRC_DIR}/zshrc_zinit
# }}}
# General {{{
# History size setting
HISTSIZE=50000
SAVEHIST=50000

# Jump word with alt-left and alt-right
bindkey "^A" vi-beginning-of-line
bindkey "^E" vi-end-of-line
bindkey "^[^[[C" forward-word
bindkey "^[^[[D" backward-word

# Set viewer
export EDITOR='vim'
export VISUAL='vim'
export PAGER='less'
# }}}
# Autocomplete {{{

# No more enter when autocomplete is finished.
zmodload zsh/complist
bindkey -M menuselect '^M' .accept-line

# Don't show dots when searching completing option
expand-or-complete-without-dots() {
  zle expand-or-complete
}
zle -N expand-or-complete-without-dots
bindkey "^I" expand-or-complete-without-dots

# Auto suggestion setting
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=240'
bindkey '^e' autosuggest-accept

export WORDCHARS='*?_-.[]~=&;!#$%^(){}<>'
# }}}
# Environment-specific {{{

# OS-specific
ZSHRC_SETUP_OS=$(uname)
[[ "${ZSHRC_SETUP_OS}" == "Darwin" ]] && source "${ZSHRC_DIR}/zshrc_darwin"
[[ "${ZSHRC_SETUP_OS}" == "Linux" ]] &&  source "${ZSHRC_DIR}/zshrc_linux"

# Custom command
[[ -f "${ZSHRC_DIR}/zshrc_command" ]] &&  source "${ZSHRC_DIR}/zshrc_command"

# Personal script setting
[[ -f "${ZSHRC_DIR}/zshrc_script" ]] &&  source "${ZSHRC_DIR}/zshrc_script"

[[ -d "${HOME}/usr/rc/script" ]] &&  export PATH="${PATH}:${HOME}/usr/rc/script"

# Local environment setting
[[ -f "${HOME}/.zshrc_local" ]] && source "${HOME}/.zshrc_local"
# }}}
# Enable autocomplete {{{
fpath=( ~/.zfunc "${fpath[@]}" )
autoload -U compinit
compinit

autoload -Uz compinit
zstyle ':completion:*' menu yes select
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
# }}}
# IDC23 - Android emulator config: {{{
export ANDROID_HOME="${HOME}/Android/Sdk"
export PATH="${PATH}:${HOME}/Android/Sdk/cmdline-tools/latest/bin/"
# }}}

# fzf
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

zstyle ':completion:*' menu select
fpath+=~/.zfunc

