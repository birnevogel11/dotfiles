#export TERM=xterm-256color

alias ls='ls --color=auto'
# alias tmux='TERM=screen-256color tmux'
alias aptupdate="sudo apt update && sudo apt upgrade -y"
(( ${+commands[htop]} )) && alias top='htop'
(( ${+commands[exa]} )) && alias ls='exa'

export PATH="${HOME}/usr/bin:${PATH}"
if [[ -d "/usr/lib/ccache" ]]; then
  export PATH=/usr/lib/ccache:$PATH
fi

if [[ -d "/home/yen3/usr/texlive/2020/bin/x86_64-linux" ]]; then
  export PATH=$PATH:/home/yen3/usr/texlive/2020/bin/x86_64-linux
fi

# Fix cursor disapearing problem
# ref: https://github.com/zsh-users/zsh-syntax-highlighting/issues/171
typeset -A ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[cursor]=underline

