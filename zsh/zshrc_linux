# export TERM=xterm-256color
# alias tmux='TERM=screen-256color tmux'
export PATH="${HOME}/usr/bin:${PATH}"

alias ls='ls --color=auto'
alias aptupdate="sudo apt update && sudo apt upgrade -y"
alias open='xdg-open'
(( ${+commands[htop]} )) && alias top='htop'
(( ${+commands[exa]} )) && alias ls='exa'

if [[ -d "/usr/lib/ccache" ]]; then
  export PATH="/usr/lib/ccache:${PATH}"
fi

if [[ -d "${HOME}/usr/texlive/2020/bin/x86_64-linux" ]]; then
  export PATH="${PATH}:${HOME}/usr/texlive/2020/bin/x86_64-linux"
fi

# Fix cursor disapearing problem
# ref: https://github.com/zsh-users/zsh-syntax-highlighting/issues/171
typeset -A ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[cursor]=underline

# Command line tools {{{
# docker-compose
zinit ice as"command" from"gh-r" mv"docker-compose* -> docker-compose"
zinit light docker/compose

# junegunn/fzf-bin
zinit ice from"gh-r" as"command"
zinit load junegunn/fzf-bin

# sharkdp/fd
zinit ice as"command" from"gh-r" mv"fd* -> fd" pick"fd/fd"
zinit light sharkdp/fd

# sharkdp/bat
zinit ice as"command" from"gh-r" mv"bat* -> bat" pick"bat/bat"
zinit light sharkdp/bat

# ogham/exa
zinit ice wait"2" lucid from"gh-r" as"program" mv"**/exa -> exa"
zinit light ogham/exa

# bcicen/ctop
zinit ice as"command" from"gh-r" mv"ctop* -> ctop" mv"ctop* -> ctop"
zinit light bcicen/ctop

# xxxserxxx/gotop
zinit ice as"command" from"gh-r" mv"gotop* -> gotop" pick"gotop* -> gotop"
zinit light xxxserxxx/gotop

# diff-so-fancy
zplugin ice as"program" pick"bin/git-dsf"
zplugin light zdharma-continuum/zsh-diff-so-fancy

# gokcehan/lf
zinit ice wait"2" lucid from"gh-r" as"program" mv"lf* -> lf"
zinit light gokcehan/lf

# BurntSushi/ripgrep
zinit ice as"command" from"gh-r" mv"ripgrep* -> rg" pick"rg/rg"
zinit light BurntSushi/ripgrep

# watchexec/watchexec
zinit ice wait"2" lucid from"gh-r" as"program" mv"watchexec* -> watchexec"
zinit light watchexec/watchexec

# dandavision/delta
zinit ice as"command" from"gh-r" mv"delta* -> delta" pick"delta/delta"
zinit light dandavison/delta

zinit ice as"command" from"gh-r" mv"btm* -> btm"
zinit light ClementTsang/bottom

zinit ice as"command" from"gh-r" mv"duf* -> duf"
zinit light muesli/duf

zinit ice as"command" from"gh-r" mv"gping* -> gping"
