# export TERM=xterm-256color
# alias tmux='TERM=screen-256color tmux'
export PATH="${HOME}/usr/bin:${PATH}"

alias ctop='TERM="${TERM/#tmux/screen}" ctop'
alias ls='ls --color=auto'
alias open='xdg-open'
(( ${+commands[htop]} )) && alias top='htop'
(( ${+commands[exa]} )) && alias ls='exa'

[[ -d "${HOME}/.local/share/neovim/bin" ]] &&  export PATH="${HOME}/.local/share/neovim/bin:${PATH}"
[[ -d "${HOME}/.local/share/nvim/mason/bin" ]] && export PATH="${PATH}:${PATH}/.local/share/nvim/mason/bin"
[[ -d "/usr/lib/ccache" ]] &&  export PATH="/usr/lib/ccache:${PATH}"
[[ -d "${HOME}/usr/texlive/2020/bin/x86_64-linux" ]] &&  export PATH="${PATH}:${HOME}/usr/texlive/2020/bin/x86_64-linux"

apt-update-trusted-packages() {
  sudo apt update
  sudo apt install --only-upgrade -y \
    git \
    htop \
    docker-ce docker-ce-cli docker-ce-rootless-extras docker-compose-plugin \
    teams \
    code \
    google-chrome-stable \
    sublime-text \
    firefox \
    neovim-runtime \
    neovim
}

# Fix cursor disapearing problem
# ref: https://github.com/zsh-users/zsh-syntax-highlighting/issues/171
typeset -A ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[cursor]=underline

