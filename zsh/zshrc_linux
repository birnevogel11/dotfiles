# export TERM=xterm-256color
# alias tmux='TERM=screen-256color tmux'
export PATH="${HOME}/usr/bin:${PATH}"

alias ctop='TERM="${TERM/#tmux/screen}" ctop'
alias ls='ls --color=auto'
alias aptupdate="sudo apt update && sudo apt upgrade -y"
alias open='xdg-open'
(( ${+commands[htop]} )) && alias top='htop'
(( ${+commands[exa]} )) && alias ls='exa'

if [[ -d "${HOME}/.local/share/neovim/bin" ]]; then
  export PATH="${HOME}/.local/share/neovim/bin:${PATH}"
fi

if [[ -d "/usr/lib/ccache" ]]; then
  export PATH="/usr/lib/ccache:${PATH}"
fi

if [[ -d "${HOME}/usr/texlive/2020/bin/x86_64-linux" ]]; then
  export PATH="${PATH}:${HOME}/usr/texlive/2020/bin/x86_64-linux"
fi

# Fix cursor disapearing problem
# ref: https://github.com/zsh-users/zsh-syntax-highlighting/issues/171
typeset -A ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[cursor]=underline

# ogham/exa
zinit ice wait"2" lucid from"gh-r" as"program" mv"**/exa -> exa"
zinit light ogham/exa

# bcicen/ctop
zinit ice as"command" from"gh-r" mv"ctop* -> ctop" mv"ctop* -> ctop"
zinit light bcicen/ctop

# BurntSushi/ripgrep
zinit ice as"command" from"gh-r" mv"ripgrep* -> rg" pick"rg/rg"
zinit light BurntSushi/ripgrep

zinit ice as"command" from"gh-r" mv"gping* -> gping"
zinit light orf/gping

zinit ice as"command" from"gh-r" mv"gitui* -> gitui"
zinit light extrawurst/gitui

zinit ice as"command" from"gh-r" mv"shellcheck -> shellcheck"
zinit light koalaman/shellcheck

