# zM: foldall
# zinit source {{{
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
source "${ZINIT_HOME}/zinit.zsh"

autoload -Uz _zinit
(( ${+_comps} )) && _comps[zinit]=_zinit
# }}}
# prompt setting {{{
zinit ice atload"fpath+=( \${PWD} );"
zinit light yen3/zsh-prompt-yen3
zinit ice svn atload"prompt yen3next" silent
zinit snippet PZT::modules/prompt
# }}}
# Autocomplete and suggesstion {{{
zinit ice wait lucid blockf atpull'zinit creinstall -q .'
zinit light zsh-users/zsh-completions
zinit light zsh-users/zsh-autosuggestions
# ref: https://github.com/zdharma-continuum/fast-syntax-highlighting/issues/154
zinit ice wait lucid atinit"zpcompinit; zpcdreplay" atload"unset 'FAST_HIGHLIGHT[chroma-whatis]' 'FAST_HIGHLIGHT[chroma-man]'"
zinit load zdharma-continuum/fast-syntax-highlighting

# }}}
# vi-mode {{{
bindkey -v
# zinit ice depth=1
# zinit light jeffreytse/zsh-vi-mode
# }}}
# prezto {{{
zinit snippet PZT::modules/helper/init.zsh
zinit snippet PZT::modules/environment/init.zsh
zinit snippet PZT::modules/docker/alias.zsh
zinit snippet PZT::modules/command-not-found/init.zsh
zinit snippet PZT::modules/directory/init.zsh

zstyle ':prezto:module:terminal' auto-title 'yes'
zinit snippet PZT::modules/terminal/init.zsh

zinit snippet PZT::modules/tmux/init.zsh
zinit snippet PZT::modules/history/init.zsh

zinit ice svn wait=1 as=null lucid
zinit snippet PZTM::archive
# }}}
# oh my zsh {{{
zinit as="completion" for OMZ::plugins/docker/_docker
zinit snippet OMZ::plugins/git/git.plugin.zsh
# zinit snippet OMZ::plugins/gh/gh.plugin.zsh
# }}}
# shell functions {{{
zinit load agkozak/zsh-z

zt(){ zinit depth'3' lucid ${1/#[0-9][a-c]/wait"${1}"} "${@:2}"; }
zt 0b light-mode for \
    autoload'#manydots-magic' \
        knu/zsh-manydots-magic

zt light-mode for \
    trigger-load'!man' \
        ael-code/zsh-colored-man-pages

zinit ice wait'1' lucid
zinit light hlissner/zsh-autopair

# zinit ice wait lucid multisrc'shell/{key-bindings,completion}.zsh'
# zinit light junegunn/fzf

export FORGIT_NO_ALIASES=1
zinit light wfxr/forgit

zinit light paulirish/git-open
zinit light Tarrasch/zsh-bd

zinit light lukechilds/zsh-nvm

zinit light coot/zsh-haskell

zinit light chrissicool/zsh-256color

# lfcd
zinit snippet https://raw.githubusercontent.com/gokcehan/lf/master/etc/lfcd.sh

# zinit light chisui/zsh-nix-shell

zinit load djui/alias-tips
# }}}
# Command line tools {{{

