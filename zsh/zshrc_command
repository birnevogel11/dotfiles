# $1: new branch name
function git-new-branch-master() {
  local -r new_branch="${1:-}"
  if [[ -z "${new_branch}" ]]; then
    echo "git-new-branch-master <new-branch-name>"
    return
  fi

  git checkout master
  git pull --rebase
  git checkout -b "${new_branch}"
}

function git-update-origin-master() {
  git fetch origin master
  git rebase -i origin/master
}

function git-pull-master() {
  local -r current_branch="$(git rev-parse --abbrev-ref HEAD)"

  if [[ $(git branch --color=never --no-column | grep main) ]]; then
    local -r master_branch="main"
  else
    local -r master_branch="master"
  fi

  if [[ "${current_branch}" != "${master_branch}" ]]; then
    git checkout "${master_branch}"
    git pull --rebase
    git checkout "${current_branch}"
  else
    git pull --rebase
  fi
}

function git-submodule-update() {
  git submodule foreach git checkout master
  git submodule --update --init
}

function yen3-git-local-config() {
  git config user.name "yen3"
  git config user.email "yen3rc@gmail.com"
}

