#!/usr/bin/env python3

import sys
from pathlib import Path

MISE_PY_VENV_TEMPLATE = """
[tools]
python = "%s"

[env]
_.python.venv = { path = "{{ env.HOME }}/.local/share/pyvenv/%s", create = true }
UV_PROJECT_ENVIRONMENT = "{{ env.HOME }}/.local/share/pyvenv/%s"
VIRTUAL_ENV = "{{ env.HOME }}/.local/share/pyvenv/%s"
"""

MISE_PY_VENV_TEMPLATE_LOCAL = """
[tools]
python = "%s"

[env]
_.python.venv = { path = "%s", create = true }
UV_PROJECT_ENVIRONMENT = "%s"
VIRTUAL_ENV = "%s"
"""


def main() -> None:
    if len(sys.argv) != 3:
        print("mise-env <python-version> <venv-name>")
        sys.exit(1)

    path = Path("./.mise.toml").resolve()
    if path.exists():
        print(f"{path} exists. Skip to generate a new one")
        sys.exit(2)

    py_ver, venv_name = sys.argv[1:3]
    if venv_name == ".venv":
        venv_path = (Path() / ".venv").resolve()
        path.write_text(MISE_PY_VENV_TEMPLATE_LOCAL % (py_ver, venv_path, venv_path, venv_path))
    else:
        path.write_text(MISE_PY_VENV_TEMPLATE % (py_ver, venv_name, venv_name, venv_name))
    print(f"Create a new mise python venv file: {path}")


if __name__ == "__main__":
    main()

