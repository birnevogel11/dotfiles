# Install_zr_packages: {{{
export ZSHRC_ZR_CONFIG_PATH="${HOME}/.config/zsh/zshrc_zr"
export ZSHRC_ZR_PATH="${HOME}/.cache/zr/zr_init.zsh"
export ZSHRC_ZR_MD5_PATH="${HOME}/.cache/zr/zr_init.zsh.md5"

ZSHRC_ZR_PKGS=(
  # prezto
  sorin-ionescu/prezto.git/modules/command-not-found/init.zsh
  sorin-ionescu/prezto.git/modules/directory/init.zsh
  sorin-ionescu/prezto.git/modules/docker/alias.zsh
  sorin-ionescu/prezto.git/modules/environment/init.zsh
  sorin-ionescu/prezto.git/modules/helper/init.zsh
  sorin-ionescu/prezto.git/modules/history/init.zsh
  sorin-ionescu/prezto.git/modules/tmux/init.zsh
  sorin-ionescu/prezto.git/modules/archive/
  # oh my zsh
  robbyrussell/oh-my-zsh.git/lib/git.zsh
  robbyrussell/oh-my-zsh.git/lib/grep.zsh
  robbyrussell/oh-my-zsh.git/lib/spectrum.zsh
  robbyrussell/oh-my-zsh.git/lib/correction.zsh
  # github
  le0me55i/zsh-extract
  ael-code/zsh-colored-man-pages
  hlissner/zsh-autopair
  junegunn/fzf.git/shell/key-bindings.zsh
  # knu/zsh-manydots-magic
  momo-lab/zsh-replace-multiple-dots
  momo-lab/zsh-abbrev-alias
  paulirish/git-open
  zdharma-continuum/fast-syntax-highlighting
  zpm-zsh/ssh
  zsh-users/zsh-autosuggestions
)

# Prompt config
export SPACESHIP_CONFIG="${HOME}/.config/zsh/spaceship.zsh"
ZSHRC_ZR_PKGS+=(birnevogel11/spaceship-prompt)

# Forgit
export FORGIT_NO_ALIASES=1
ZSHRC_ZR_PKGS+=(wfxr/forgit)

setopt promptsubst

if [[ ! -f "${ZSHRC_ZR_PATH}" ]] || \
   [[ ! -f "${ZSHRC_ZR_MD5_PATH}" ]] || \
   [[ "$(md5sum "${ZSHRC_ZR_CONFIG_PATH}" | \
     awk '{ print $1 }')" != "$(cat "${ZSHRC_ZR_MD5_PATH}")" ]]; then
  mkdir -p "$(dirname ${ZSHRC_ZR_PATH})"
  zr "${ZSHRC_ZR_PKGS[@]}" > "${ZSHRC_ZR_PATH}"
  md5sum "${ZSHRC_ZR_CONFIG_PATH}" | awk '{ print $1 }' > "${ZSHRC_ZR_MD5_PATH}"
fi

source "${ZSHRC_ZR_PATH}"
