# vim: ft=zsh foldmethod=marker foldcolumn=1 foldlevelstart=0
# zM: foldall
##############################################################################
# Global setting
##############################################################################
# Global path and language setting {{{
export LC_ALL="en_US.UTF-8"
export LANG="en_US.UTF-8"
export ZSHRC_DIR="${HOME}/.config/zsh"
export PATH="${PATH}:${HOME}/usr/bin:${HOME}/.local/bin:${HOME}/.local/bin:${HOME}/usr/rc/script"
# zr depends on cargo. `cargo install zr`
export PATH="$HOME/.cargo/bin:$PATH"
# }}}
# zr: {{{
source "${ZSHRC_DIR}/zshrc_zr"
# }}}
# General {{{
# History size setting
HISTSIZE=50000
SAVEHIST=50000

# Jump word with alt-left and alt-right
bindkey "^A" vi-beginning-of-line
bindkey "^E" vi-end-of-line
bindkey "^[^[[C" forward-word
bindkey "^[^[[D" backward-word

# Set viewer
export EDITOR='vim'
export VISUAL='vim'
export PAGER='less'

# Enable vi-mode
bindkey -v

export WORDCHARS='*?.[]~=&;!#$%^(){}<>-'
# }}}
# Environment-specific {{{

# OS-specific
[[ "$(uname)" == "Darwin" ]] && source "${ZSHRC_DIR}/zshrc_darwin"
[[ "$(uname)" == "Linux" ]]  && source "${ZSHRC_DIR}/zshrc_linux"

# Custom command
[[ -f "${ZSHRC_DIR}/zshrc_command" ]] && source "${ZSHRC_DIR}/zshrc_command"

[[ -d "${HOME}/usr/rc/script" ]]      && export PATH="${PATH}:${HOME}/usr/rc/script"

# Local environment setting
[[ -f "${HOME}/.zshrc_local" ]]       && source "${HOME}/.zshrc_local"
# }}}

##############################################################################
# Command line tools
##############################################################################
# Android emulator config: {{{
if [ -d "${HOME}/Android/Sdk" ]; then
  export ANDROID_HOME="${HOME}/Android/Sdk"
  export PATH="${PATH}:${HOME}/Android/Sdk/cmdline-tools/latest/bin/"
fi
# }}}
# Rust {{{
if [[ -d $HOME/.cargo/bin ]] && [[ -f $HOME/.cargo/env ]]; then
  autoload -Uz compinit
  source $HOME/.cargo/env
fi
# }}}
# fzf: {{{
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
zstyle ':completion:*' menu select
fpath+=~/.zfunc
# }}}
# mise: {{{
if (( ${+commands[mise]} )); then
  export MISE_PYTHON_DEFAULT_PACKAGES_FILE="${HOME}/.config/mise/mise-python-packages"
  export MISE_NODE_DEFAULT_PACKAGES_FILE="${HOME}/.config/mise/mise-node-packages"

  eval "$(mise activate zsh)"
  export PATH="$HOME/.local/share/mise/shims:$PATH"
  # export MISE_ENV_FILE=.envrc
fi
# }}}
# ghcup: {{{
if [[ "$(uname)" == "Darwin" ]]; then
fi

if [[ "$(uname)" == "Linux" ]]; then
fi
# }}}
# Pyenv {{{
if [[ -d "${HOME}/.pyenv" ]]; then
  export PATH=${HOME}/.pyenv/bin:${PATH}

  # eval "$(pyenv init -)"
  # eval "$(pyenv virtualenv-init -)"
  if command -v pyenv 1>/dev/null 2>&1
  then
     eval "$(pyenv init --path)"
  fi
  source $(pyenv root)/completions/pyenv.zsh
fi
# }}}
# bob-nvim: {{{
if (( ${+commands[bob]} )); then
export PATH="${HOME}/.local/share/bob/nvim-bin:$PATH"
fi
# }}}
# jumper: {{{
if (( ${+commands[jumper]} )); then
  export __JUMPER_FOLDERS="${HOME}/.jumper/jfolders"
  export __JUMPER_FILES="${HOME}/.jumper/jfiles"
  source "${HOME}/.local/share/jumper/jumper.zsh"
fi
# }}}
