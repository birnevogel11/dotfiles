export LC_CTYPE=en_US.UTF-8

if [[ -d "${HOME}/.local/share/neovim/bin" ]]; then
  export PATH="${HOME}/.local/share/neovim/bin:${PATH}"
fi

if [[ -d "/usr/local/opt/grep/libexec/gnubin" ]]; then
  export PATH="/usr/local/opt/grep/libexec/gnubin:${PATH}"
fi

if [[ -d  "/usr/local/opt/curl/bin" ]]; then
  export PATH="/usr/local/opt/curl/bin:$PATH"
fi

if [ -f ${HOME}/usr/tools/gcc/bin/gcc ]; then
  export MANPATH="$HOME/usr/tools/gcc/share/man:$MANPATH"
fi

# Enable ccache
if [[ -d "/usr/local/opt/ccache/libexec" ]]; then
  export PATH=/usr/local/opt/ccache/libexec:$PATH
fi

if [[ -d "/usr/local/opt/llvm/bin" ]]; then
  export PATH="${PATH}:/usr/local/opt/llvm/bin"
fi

(( ${+commands[exa]} )) && alias ls='exa'
(( ${+commands[eza]} )) && alias ls='eza'
# alias ls='ls -Gv'
# alias ll='ls -lh'
# alias la='ls -alh'
alias htop='sudo htop'

if (( ${+commands[gmake]} )); then
  alias make='gmake'
fi

if (( ${+commands[gtar]} )); then
  alias tar='gtar'
fi
