" zM: foldall
" Preamble {{{
let s:is_mac = (has('mac') || has('macunix') || has('gui_macvim')
            \ || system('uname') =~? '^darwin')
let s:is_linux = !s:is_mac

if !has('nvim')
  let $DOTVIM = expand('$HOME/.vim')
else
  let $DOTVIM = expand('$HOME/.config/nvim')
endif

if !has('nvim')
  set viminfo+=n~/.local/share/vim/viminfo
endif

" remapping the leader key
let g:mapleader = ","
" }}}
" Plugin Selection: {{{
" 0: Disable
" 1: deoplete.nvim + nvim-lsp
" 2: nvim-lua/completion-nvim
let g:yen3_auto_complete_selection = 2
" 0: Disable
" 1: Enable dev-icons
let g:yen3_enable_dev_icons = 0
" 0: Disable
" 1: Denite
" 2: nvim-telescope/telescope.nvim
let g:yen3_search_selection = 1
" 1: Defx
" 2: Fern
let g:yen3_file_explorer = 1
" }}}
" Plugin: {{{
if &compatible
  set nocompatible
endif

call plug#begin('~/.cache/vim-plug')

"" Color scheme
" Plug 'petobens/colorish'
Plug 'tjdevries/colorbuddy.nvim'

"" Apperence
Plug 'mkitt/tabline.vim'
Plug 'wsdjeg/vim-todo'
Plug 'tpope/vim-sensible'
Plug 'majutsushi/tagbar'
Plug 'tenfyzhong/tagbar-makefile.vim'
Plug 'tjdevries/train.nvim'
" Plug 'pearofducks/ansible-vim'
" Plug 'neomake/neomake'

"" Status line
Plug 'vim-airline/vim-airline'
" Plug 'vim-airline/vim-airline-themes'

" Generic
Plug 'nvim-treesitter/nvim-treesitter', {'do': ':TSUpdate'}
Plug 'nvim-treesitter/playground'
Plug 'Shougo/vimproc.vim', {'do': 'make'}
Plug 'Shougo/defx.nvim'
if g:yen3_file_explorer == 1
  Plug 'kristijanhusak/defx-git'
  if g:yen3_enable_dev_icons == 1
    Plug 'kristijanhusak/defx-icons'
  endif
elseif g:yen3_file_explorer == 2
  Plug 'lambdalisue/fern.vim'
endif
Plug 'aymericbeaumet/vim-symlink'
Plug 'embear/vim-localvimrc'
Plug 'puremourning/vimspector'
let g:polyglot_disabled = ['cpp', 'c', 'python', 'haskell']
Plug 'sheerun/vim-polyglot'
if s:is_mac
  Plug 'rizzatti/dash.vim'
endif
Plug 'vim-test/vim-test'
" Plug 'rcarriga/vim-ultest'
Plug 'benmills/vimux'
Plug 'kamykn/spelunker.vim'
Plug 'senderle/restoreview', {'branch': 'main'}
if executable('xkbswitch')
  Plug 'rlue/vim-barbaric'
endif
Plug 'ptzz/lf.vim'
Plug 'voldikss/vim-floaterm'

"" Edit
Plug 'dense-analysis/ale'
Plug 'MarcWeber/vim-addon-mw-utils'
Plug 'tpope/vim-abolish'
Plug 'tpope/vim-dispatch'
Plug 'tpope/vim-endwise'
Plug 'tpope/vim-rhubarb'
Plug 'tpope/vim-sensible'
Plug 'tpope/vim-speeddating'
Plug 'tpope/vim-surround'
Plug 'Yggdroot/indentLine'

Plug 'scrooloose/nerdcommenter'
Plug 'Raimondi/delimitMate'
Plug 'michaeljsmith/vim-indent-object'
Plug 'ntpeters/vim-better-whitespace'
Plug 'Chiel92/vim-autoformat'

Plug 'kevinhwang91/nvim-bqf', {'branch': 'main'}
Plug 'junegunn/fzf', { 'do': { -> fzf#install() } }
Plug 'google/vim-searchindex'

"" Bitbake
Plug 'kergoth/vim-bitbake'

"" csv
Plug 'chrisbra/csv.vim', {'for': 'csv'}

"" Haskell
Plug 'yen3/haskell-vim', {'for': 'haskell', 'branch': 'record-color'}
Plug 'alx741/vim-hindent', {'for': 'haskell'}
Plug 'alx741/vim-stylishask', {'for': 'haskell'}
Plug 'Twinside/vim-hoogle', {'for': 'haskell'}
Plug 'dan-t/vim-hsimport', {'for': 'haskell'}

"" LaTeX
Plug 'lervag/vimtex', {'for': 'tex'}

"" C/Cpp
Plug 'octol/vim-cpp-enhanced-highlight', {'for': ['c', 'cpp']}
Plug 'rhysd/vim-clang-format', {'for': ['c', 'cpp']}
Plug 'vim-scripts/cscope.vim', {'for': ['c', 'cpp']}

"" Go
Plug 'fatih/vim-go', {'for': 'go'}

"" Rust
Plug 'rust-lang/rust.vim', {'for': 'rust'}

"" Markdown
Plug 'plasticboy/vim-markdown', {'for' : 'markdown'}
Plug 'iamcco/markdown-preview.nvim', { 'do': { -> mkdp#util#install() }, 'for': ['markdown', 'vim-plug']}

"" TOML
Plug 'cespare/vim-toml', {'for': 'toml'}

"" Python
Plug 'vim-python/python-syntax', {'for' : 'python'}
Plug 'ambv/black', {'for': 'python' }
Plug 'jeetsukumaran/vim-pythonsense', {'for': 'python' }
if executable('stack')
Plug 'https://gitlab.com/yen3/pyimport-sort-cdm.git', {'for': 'python', 'do': 'stack install'}
endif
Plug 'wookayin/vim-autoimport', {'for': 'python'}

"" JavaScript/TypeScript
Plug 'alvan/vim-closetag'
Plug 'pangloss/vim-javascript'
Plug 'mxw/vim-jsx'
Plug 'othree/yajs.vim'
Plug 'HerringtonDarkholme/yats.vim', {'do': 'rm -rf UltiSnips'}
Plug 'turbio/bracey.vim', {'do': 'npm install --prefix server'}
Plug 'prettier/vim-prettier'

"" ocaml
" Plug 'ocaml/vim-ocaml', {'for': 'ocaml'}

"" Git
Plug 'tpope/vim-fugitive'
Plug 'tpope/vim-dispatch'
Plug 'sodapopcan/vim-twiggy'
Plug 'lambdalisue/gina.vim'
Plug 'junegunn/gv.vim', {'on': 'GV'}
" Plug 'int3/vim-extradite'
" Plug 'rhysd/git-messenger.vim', {'on': 'GitMessenger'}
Plug 'nvim-lua/plenary.nvim'
Plug 'lewis6991/gitsigns.nvim', {'branch': 'main'}

"" COOL
" Plug 'vim-scripts/cool.vim', {'for': 'cool'}

"" Tmux
if !empty('$TMUX')
  Plug 'christoomey/vim-tmux-navigator'
  Plug 'wellle/tmux-complete.vim'
  Plug 'tmux-plugins/vim-tmux-focus-events'
endif

"" Search
if g:yen3_search_selection == 1
  " Denite
  Plug 'Shougo/denite.nvim'
  Plug 'chemzqm/denite-git'
  Plug 'neoclide/denite-extra'
  Plug 'raghur/fruzzy'
  Plug 'Shougo/neomru.vim'
  Plug 'Shougo/neoyank.vim'
  Plug 'rafi/vim-denite-z'
  Plug 'kmnk/denite-dirmark'
  Plug 'yyotti/denite-marks'
  Plug 'Shougo/unite.vim'
  Plug 'Shougo/unite-outline'
elseif g:yen3_search_selection == 2
  Plug 'nvim-lua/popup.nvim'
  Plug 'nvim-lua/plenary.nvim'
  Plug 'nvim-telescope/telescope.nvim'
  Plug 'nvim-telescope/telescope-frecency.nvim'
  Plug 'nvim-telescope/telescope-fzy-native.nvim'
endif

"" Snippet
Plug 'SirVer/ultisnips'
Plug 'mlaursen/vim-react-snippets'
" Plug 'honza/vim-snippets'

"" Autocomplete
if g:yen3_auto_complete_selection == 1
  Plug 'Shougo/deoplete.nvim', {'do': ':UpdateRemotePlugins'}

  Plug 'Shougo/deoplete-lsp'

  Plug 'neovim/nvim-lspconfig'
  Plug 'glepnir/lspsaga.nvim', {'branch': 'main'}

  Plug 'Shougo/neco-syntax'                                        " language syntax
  Plug 'zchee/deoplete-jedi', {'on_ft': 'python'}                  " Python
  Plug 'davidhalter/jedi-vim', {'on_ft': 'python'}

elseif g:yen3_auto_complete_selection == 2
  Plug 'neovim/nvim-lspconfig'
  Plug 'glepnir/lspsaga.nvim', {'branch': 'main'}
  Plug 'ray-x/lsp_signature.nvim'

  Plug 'nvim-lua/completion-nvim'
  Plug 'steelsojka/completion-buffers'
  Plug 'nvim-treesitter/completion-treesitter'
  Plug 'nvim-treesitter/nvim-treesitter-textobjects'
  Plug 'albertoCaroM/completion-tmux', {'branch': 'main'}

  Plug 'davidhalter/jedi-vim', {'on_ft': 'python'}
endif

if has('nvim')
  " ref: https://github.com/petobens/dotfiles/blob/master/vim/init.vim#L190
  " This basically fixes visual block pasting
  " https://github.com/neovim/neovim/issues/1822#issuecomment-233152833
  Plug 'bfredl/nvim-miniyank'
endif

if g:yen3_enable_dev_icons == 1
  " Devicons (load this last!)
  Plug 'ryanoasis/vim-devicons'
endif

call plug#end()
" }}}
" lua setting: {{{
lua require 'config'
" }}}
" Plugin setting: {{{
source ~/.config/nvim/vim/plugin.vim
" }}}
" Plugin autocomplete: {{{
source ~/.config/nvim/vim/autocomplete.vim
" }}}
" Plugin search: {{{
source ~/.config/nvim/vim/search.vim
" }}}
" General setting: {{{
source ~/.config/nvim/vim/general.vim
" }}}
" Local setting {{{
if filereadable($HOME . "/.vimrc_local")
  source ~/.vimrc_local
endif
" }}}


