{
  "import": {
    "prefix": ["imp"],
    "body": ["import ${1:module} ${2:(${3:f})}$0"],
    "description": "Simple import"
  },
  "import_qualified": {
    "prefix": ["impq"],
    "body": ["import qualified ${1:module} as ${2:name}"],
    "description": "Qualified import"
  },
  "import_specific": {
    "prefix": ["imps"],
    "body": ["import ${1:module} (${2:name})"],
    "description": "Import name only"
  }
}
