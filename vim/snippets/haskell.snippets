priority -50

snippet imp "Simple import"
import ${1}$0
endsnippet

snippet imps "Selective import"
import ${1} (${2})${0}$0
endsnippet

snippet impq "Qualified import"
import qualified ${1} as ${2}$0
endsnippet

snippet lang "Language extension"
{-# LANGUAGE ${1} #-}$0
endsnippet

snippet fun "Function"
${1} :: ${2}
$1 ${3} = ${4}
endsnippet

# vim:ft=snippets:
